# ---------------------------------------------------------------------------
# Stellar / Noir
# ---------------------------------------------------------------------------
# Soroban RPC used by the Noir agent SDK.
NOIR_RPC_URL=https://soroban-testnet.stellar.org

# Latest Noir Testnet deployment (the deployment referenced by the hackathon brief).
NOIR_DEVICE_REGISTRY=CB4DPMGOA374JIB2ZVD4AHW5GJKQUYNOFGRYNOJ75EFH2KCJSMHOWIRA
NOIR_AGENT_REGISTRY=CBTDMJVCFQDIVWZBKAKZ2FQ3UEJNAAUFYCTJ3E4ON2MYXPLPSIXQ25JZ
NOIR_PAYMENT_ESCROW=CA5S4S7QGHJHJWVJBYL3CXZXZTNGKXMNZVDAEQNN7NUXFP4D7BYK7HIX

# ---------------------------------------------------------------------------
# Velo
# ---------------------------------------------------------------------------
# Server-side only. Create a Testnet key in the Velo project dashboard.
VELO_API_KEY=
VELO_ENV=testnet
VELO_BASE_URL=https://www.velo-build.dev
VELO_WEBHOOK_SECRET=

# Public URL used for Velo checkout redirects and webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Override the state directory (Render persistent disk, containers).
# Defaults to <project>/.data.
PACTUM_DATA_DIR=

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------
# When absent, PACTUM uses its deterministic policy planner (fully functional).
OPENAI_API_KEY=
PACTUM_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Demo wallet (optional)
# ---------------------------------------------------------------------------
# Leave blank to let PACTUM generate and persist a fresh Testnet vault in .data/.
PACTUM_OWNER_SECRET=
PACTUM_AGENT_SECRET=
PACTUM_MERCHANT_SECRET=
PACTUM_USDC_ISSUER_SECRET=
